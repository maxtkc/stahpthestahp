    "@types/d3-scale": "^4.0.9",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^6.39.0",
    "prettier": "^3.9.9",
